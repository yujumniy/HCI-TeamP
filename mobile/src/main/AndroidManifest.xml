<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity android:name=".experiment.StudyActivity" android:exported="false" />
        <activity android:name=".experiment.ExperimentActivity" android:exported="false" />

        <!-- Phase 1 C1·C2 입력 검증 (팀원 1). 별도 아이콘으로 실행 -->
        <activity
            android:name=".experiment.input.check.InputCheckActivity"
            android:exported="true"
            android:label="C1·C2 입력 검증"
            android:screenOrientation="portrait"
            android:taskAffinity="com.hci.teamp.inputcheck"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="com.hci.teamp.mobile.sync.PhoneSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hci/v1" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/hci_volume_watch" />
            </intent-filter>
        </service>

        <activity
            android:name="com.hci.teamp.mobile.debug.CommTestActivity"
            android:exported="false"
            android:label="T3 통신 검증" />
    </application>
</manifest>
